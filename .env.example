# Configuração exclusiva do servidor
PORT=3001
HOST=127.0.0.1
REQUIRE_TECH_SIGNATURE=false
# Em produção, configure o URL HTTPS público sem barra final.
PUBLIC_ORIGIN=
# Use 1 apenas atrás de exatamente um proxy confiável e inacessível diretamente.
TRUST_PROXY_HOPS=0
# Monte um volume persistente em produção.
RECEIPTS_DIR=./data/receipts

# test gera o PDF e uma mensagem MIME em memória, sem conexão SMTP.
# Use smtp e preencha MAIL_TO para ativar o envio. Sem destinatário, o RAT gera apenas o PDF.
MAIL_MODE=test
MAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
