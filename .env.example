NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# PostgreSQL central. Em produção use a conexão TLS indicada pelo provedor.
DATABASE_URL=
# Obrigatória em produção, exemplo de formato https://rat.suaempresa.com.br
PUBLIC_ORIGIN=
TRUST_PROXY_HOPS=0

PHOTO_MAX_COUNT=12
PHOTO_MAX_FILE_MB=10
PHOTO_MAX_BYTES=600000
PHOTO_MAX_EDGE=1600
PHOTO_QUALITY=78

# PostgreSQL separado para os testes. Não é usado pela aplicação.
TEST_DATABASE_URL=
